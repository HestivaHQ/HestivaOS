NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hestiva_os
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_URL=http://localhost:4000

# Destructive pre-launch reset gate. Keep false/unset outside a deliberate LR-1 reset window.
HESTIVA_LAUNCH_BASELINE_RESET_ENABLED=false

# Quote Send + Tracking V1 — values belong in protected runtime configuration.
RESEND_API_KEY=
RESEND_WEBHOOK_SIGNING_SECRET=
HESTIVA_CORRESPONDENCE_QUOTE_FROM=Homent Quotes <quotes@homent.co.za>
HESTIVA_CORRESPONDENCE_QUOTE_REPLY_TO=quotes@homent.co.za
HESTIVA_QUOTE_CUSTOMER_PUBLIC_ORIGIN=https://example.invalid
