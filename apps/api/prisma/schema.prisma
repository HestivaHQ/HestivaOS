generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum TechnicianStatus {
  ACTIVE
  INACTIVE
}

enum CrewStatus {
  ACTIVE
  INACTIVE
}

enum ShiftStatus {
  DRAFT
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ServiceType {
  PRIMARY
  ADD_ON
  BOTH
}

enum CleaningJobTemplateStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderChecklistItemStatus {
  PENDING
  COMPLETED
  NOT_APPLICABLE
}

enum WorkOrderPhotoCategory {
  BEFORE
  AFTER
}

enum WorkOrderStatus {
  NEW
  ASSIGNED
  ACCEPTED
  TRAVELLING
  ON_SITE
  WAITING_FOR_PARTS
  COMPLETED
  CLOSED
  CANCELLED
}

enum WorkOrderActivityType {
  WORK_ORDER_CREATED
  STATUS_CHANGED
  TECHNICIAN_ASSIGNED
  TECHNICIAN_CHANGED
  TECHNICIAN_REMOVED
  CREW_ASSIGNED
  CREW_CHANGED
  CREW_REMOVED
  WORK_ORDER_CLOSED
  WORK_ORDER_CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkOrderFrequency {
  ONE_TIME
  WEEKLY
  EVERY_TWO_WEEKS
  MONTHLY
  CUSTOM
}

enum HomeCondition {
  LIGHT_UPKEEP
  STANDARD
  EXTRA_ATTENTION
  HEAVY_BUILDUP
  RECENTLY_RENOVATED
  VACANT
  MOVE_IN_OUT
}

enum UserRole {
  ADMIN
  OPERATIONS_MANAGER
  DISPATCHER
  SUPERVISOR
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum BusinessListType {
  JOB_TITLE
  DEPARTMENT
  PROPERTY_TYPE
}

model User {
  id String @id @default(uuid()) @db.Uuid
  authUserId String @unique @map("auth_user_id") @db.Uuid
  email String @unique
  firstName String @map("first_name")
  lastName String @map("last_name")
  displayName String? @map("display_name")
  phoneNumber String? @map("phone_number")
  jobTitle String? @map("job_title")
  department String?
  profilePhotoUrl String? @map("profile_photo_url")
  role UserRole @default(TECHNICIAN)
  status UserStatus @default(ACTIVE)
  employeeRecord EmployeeRecord?
  customers Customer[] @relation("CustomerOwner")
  workOrders WorkOrder[] @relation("WorkOrderCreator")
  workOrderActivities WorkOrderActivity[] @relation("WorkOrderActivityActor")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("users")
}

model BusinessProfile {
  id                       String   @id @default("hestiva")
  registeredName           String?  @map("registered_name")
  tradingName              String?  @map("trading_name")
  registrationNumber       String?  @map("registration_number")
  contactNumber            String?  @map("contact_number")
  businessEmail            String?  @map("business_email")
  website                  String?
  businessAddress          String?  @map("business_address")
  bankName                 String?  @map("bank_name")
  accountHolder            String?  @map("account_holder")
  accountNumber            String?  @map("account_number")
  accountType              String?  @map("account_type")
  branchCode               String?  @map("branch_code")
  paymentInstructions      String?  @map("payment_instructions")
  taxNumber                String?  @map("tax_number")
  vatNumber                String?  @map("vat_number")
  officialIdentifiers      String?  @map("official_identifiers")
  shareRegisteredName      Boolean  @default(true) @map("share_registered_name")
  shareTradingName         Boolean  @default(true) @map("share_trading_name")
  shareRegistrationNumber  Boolean  @default(true) @map("share_registration_number")
  shareContactNumber       Boolean  @default(true) @map("share_contact_number")
  shareBusinessEmail       Boolean  @default(true) @map("share_business_email")
  shareWebsite             Boolean  @default(true) @map("share_website")
  shareBusinessAddress     Boolean  @default(true) @map("share_business_address")
  shareBankName            Boolean  @default(false) @map("share_bank_name")
  shareAccountHolder       Boolean  @default(false) @map("share_account_holder")
  shareAccountNumber       Boolean  @default(false) @map("share_account_number")
  shareAccountType         Boolean  @default(false) @map("share_account_type")
  shareBranchCode          Boolean  @default(false) @map("share_branch_code")
  sharePaymentInstructions Boolean  @default(false) @map("share_payment_instructions")
  shareTaxNumber           Boolean  @default(false) @map("share_tax_number")
  shareVatNumber           Boolean  @default(false) @map("share_vat_number")
  shareOfficialIdentifiers Boolean  @default(false) @map("share_official_identifiers")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("business_profiles")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  name String
  contactName String? @map("contact_name")
  email String?
  phone String?
  notes String?
  status CustomerStatus @default(ACTIVE)
  owner User @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  properties Property[]
  workOrders WorkOrder[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([ownerId])
  @@index([name])
  @@map("customers")
}

model Property {
  id String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  name String
  addressLine1 String @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city String
  province String?
  postalCode String? @map("postal_code")
  country String @default("South Africa")
  accessNotes String? @map("access_notes")
  bedrooms BedroomCount?
  bathrooms BathroomCount?
  livingAreas LivingAreaCount? @map("living_areas")
  storeys StoreyCount?
  floorSize FloorSize? @map("floor_size")
  outdoorArea OutdoorArea? @map("outdoor_area")
  estateClassification EstateClassification? @map("estate_classification")
  unitFloor UnitFloor? @map("unit_floor")
  isEstateOrComplex Boolean? @map("is_estate_or_complex")
  requiresGateSecurityAccess Boolean? @map("requires_gate_security_access")
  parkingNotes String? @map("parking_notes")
  hasPets Boolean? @map("has_pets")
  petNotes String? @map("pet_notes")
  hasCameras Boolean? @map("has_cameras")
  offLimitsNotes String? @map("off_limits_notes")
  fragileItemNotes String? @map("fragile_item_notes")
  productRestrictionNotes String? @map("product_restriction_notes")
  allergyNotes String? @map("allergy_notes")
  propertyTypeOptionId String? @map("property_type_option_id") @db.Uuid
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyTypeOption BusinessListOption? @relation("PropertyType", fields: [propertyTypeOptionId], references: [id], onDelete: Restrict)
  workOrders WorkOrder[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([customerId])
  @@index([propertyTypeOptionId])
  @@index([city])
  @@map("properties")
}

enum BedroomCount {
  STUDIO
  ONE
  TWO
  THREE
  FOUR
  FIVE_PLUS
  OTHER
}

enum BathroomCount {
  ONE
  TWO
  THREE
  FOUR
  FIVE_PLUS
}

enum LivingAreaCount {
  ONE
  TWO
  THREE
  FOUR_PLUS
}

enum StoreyCount {
  ONE
  TWO
  THREE_PLUS
  THREE
  FOUR_PLUS
  UNKNOWN
}

enum FloorSize {
  UNDER_80
  FROM_80_TO_150
  FROM_151_TO_250
  OVER_250
  UNKNOWN
}
enum OutdoorArea {
  NONE
  BALCONY
  PATIO
  BOTH
}
enum EstateClassification {
  NONE
  ESTATE
  COMPLEX
  GATED_COMMUNITY
}
enum UnitFloor {
  GROUND
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH_TO_NINTH
  TENTH_PLUS
  THIRD_PLUS
  UNKNOWN
}

model Technician {
  id String @id @default(uuid()) @db.Uuid
  firstName String @map("first_name")
  lastName String @map("last_name")
  email String? @unique
  phone String?
  skills String[] @default([])
  notes String?
  status TechnicianStatus @default(ACTIVE)
  employeeRecord EmployeeRecord?
  workOrders WorkOrder[]
  shifts Shift[]
  crewMembership CrewMember?
  ledCrews Crew[] @relation("CrewLeader")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([lastName, firstName])
  @@map("technicians")
}

model EmployeeRecord {
  id                    String         @id @default(uuid()) @db.Uuid
  employeeReference     String         @unique @map("employee_reference")
  firstName             String         @map("first_name")
  lastName              String         @map("last_name")
  preferredName         String?        @map("preferred_name")
  phone                 String?
  email                 String?
  residentialAddress    String?        @map("residential_address")
  emergencyContactName  String?        @map("emergency_contact_name")
  emergencyRelationship String?        @map("emergency_relationship")
  emergencyContactPhone String?        @map("emergency_contact_phone")
  status                EmployeeStatus @default(ACTIVE)
  jobTitle              String?        @map("job_title")
  department            String?
  jobTitleOptionId      String?        @map("job_title_option_id") @db.Uuid
  departmentOptionId    String?        @map("department_option_id") @db.Uuid
  startDate             DateTime?      @map("start_date") @db.Date
  endDate               DateTime?      @map("end_date") @db.Date
  internalNotes         String?        @map("internal_notes")
  userId                String?        @unique @map("user_id") @db.Uuid
  technicianId          String?        @unique @map("technician_id") @db.Uuid
  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  technician            Technician?    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  jobTitleOption        BusinessListOption? @relation("EmployeeJobTitle", fields: [jobTitleOptionId], references: [id], onDelete: Restrict)
  departmentOption      BusinessListOption? @relation("EmployeeDepartment", fields: [departmentOptionId], references: [id], onDelete: Restrict)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@index([lastName, firstName])
  @@index([status])
  @@index([jobTitleOptionId])
  @@index([departmentOptionId])
  @@map("employee_records")
}

model BusinessListOption {
  id                  String           @id @default(uuid()) @db.Uuid
  type                BusinessListType
  label               String
  normalizedLabel     String           @map("normalized_label")
  isActive            Boolean          @default(true) @map("is_active")
  sortOrder           Int              @default(0) @map("sort_order")
  employeeJobTitles   EmployeeRecord[] @relation("EmployeeJobTitle")
  employeeDepartments EmployeeRecord[] @relation("EmployeeDepartment")
  properties          Property[]       @relation("PropertyType")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@unique([type, normalizedLabel])
  @@index([type, isActive, sortOrder])
  @@map("business_list_options")
}

model Crew {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  description String?
  leaderId String? @map("leader_id") @db.Uuid
  status CrewStatus @default(ACTIVE)
  leader Technician? @relation("CrewLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members CrewMember[]
  workOrders WorkOrder[]
  shifts Shift[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([status])
  @@map("crews")
}

model CrewMember {
  crewId String @map("crew_id") @db.Uuid
  technicianId String @unique @map("technician_id") @db.Uuid
  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@id([crewId, technicianId])
  @@index([crewId])
  @@map("crew_members")
}

model Shift {
  id String @id @default(uuid()) @db.Uuid
  title String
  startAt DateTime @map("start_at")
  endAt DateTime @map("end_at")
  unpaidBreakMinutes Int @default(0) @map("unpaid_break_minutes")
  crewId String? @map("crew_id") @db.Uuid
  technicianId String? @map("technician_id") @db.Uuid
  workOrderId String? @map("work_order_id") @db.Uuid
  location String?
  notes String?
  status ShiftStatus @default(DRAFT)
  crew Crew? @relation(fields: [crewId], references: [id], onDelete: SetNull)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([startAt, endAt])
  @@index([crewId, startAt])
  @@index([technicianId, startAt])
  @@index([workOrderId])
  @@index([status])
  @@map("shifts")
}

model Service {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  normalizedName String? @unique @map("normalized_name")
  description String?
  defaultDurationMinutes Int? @map("default_duration_minutes")
  status ServiceStatus @default(ACTIVE)
  type ServiceType @default(PRIMARY)
  jobTemplates CleaningJobTemplate[]
  workOrders WorkOrder[]
  workOrderAddOns WorkOrderAddOn[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([name])
  @@index([status])
  @@index([type])
  @@map("services")
}

model CleaningJobTemplate {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  description String?
  estimatedDurationMinutes Int? @map("estimated_duration_minutes")
  status CleaningJobTemplateStatus @default(ACTIVE)
  services Service[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([name])
  @@index([status])
  @@map("cleaning_job_templates")
}

model WorkOrder {
  id String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  technicianId String? @map("technician_id") @db.Uuid
  crewId String? @map("crew_id") @db.Uuid
  serviceId String? @map("service_id") @db.Uuid
  reference String? @unique
  title String
  description String?
  frequency WorkOrderFrequency?
  customFrequencyNote String? @map("custom_frequency_note")
  homeCondition HomeCondition? @map("home_condition")
  status WorkOrderStatus @default(NEW)
  priority WorkOrderPriority @default(NORMAL)
  scheduledAt DateTime? @map("scheduled_at")
  completedAt DateTime? @map("completed_at")
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy User @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  crew Crew? @relation(fields: [crewId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  addOns WorkOrderAddOn[]
  shifts Shift[]
  activities WorkOrderActivity[]
  checklistItems WorkOrderChecklistItem[]
  photos WorkOrderPhoto[]
  customerSignOff WorkOrderCustomerSignOff?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([customerId])
  @@index([propertyId])
  @@index([createdById])
  @@index([technicianId])
  @@index([crewId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledAt])
  @@map("work_orders")
}

model WorkOrderAddOn {
  workOrderId String @map("work_order_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([workOrderId, serviceId])
  @@index([serviceId])
  @@map("work_order_add_ons")
}

model WorkOrderDailyCounter {
  businessDate String @id @map("business_date")
  sequence Int
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("work_order_daily_counters")
}

model WorkOrderChecklistItem {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  description String
  status WorkOrderChecklistItemStatus @default(PENDING)
  sortOrder Int @default(0) @map("sort_order")
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([workOrderId, sortOrder])
  @@map("work_order_checklist_items")
}

model WorkOrderPhoto {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  category WorkOrderPhotoCategory
  url String
  storagePath String @map("storage_path")
  uploadedBy String @map("uploaded_by")
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([workOrderId, category, createdAt])
  @@map("work_order_photos")
}

model WorkOrderCustomerSignOff {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @unique @map("work_order_id") @db.Uuid
  customerName String @map("customer_name")
  signatureDataUrl String @map("signature_data_url")
  note String?
  acceptedAt DateTime @default(now()) @map("accepted_at")
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  @@map("work_order_customer_sign_offs")
}

model WorkOrderActivity {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  type WorkOrderActivityType
  previousStatus WorkOrderStatus? @map("previous_status")
  newStatus WorkOrderStatus? @map("new_status")
  note String?
  actorId String? @map("actor_id") @db.Uuid
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor User? @relation("WorkOrderActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([workOrderId])
  @@index([createdAt])
  @@index([workOrderId, createdAt])
  @@map("work_order_activities")
}
