enum CorrespondenceTemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CorrespondenceDeliveryAttemptStatus {
  PENDING
  ACCEPTED
  FAILED
}

model CorrespondenceTemplate {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  name String
  versions CorrespondenceTemplateVersion[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("correspondence_templates")
}

model CorrespondenceTemplateVersion {
  id String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  version Int
  status CorrespondenceTemplateVersionStatus @default(DRAFT)
  subject String?
  body String
  publishedAt DateTime? @map("published_at")
  retiredAt DateTime? @map("retired_at")
  template CorrespondenceTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  records CorrespondenceRecord[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("correspondence_template_versions")
}

model CorrespondenceRecord {
  id String @id @default(uuid()) @db.Uuid
  templateVersionId String @map("template_version_id") @db.Uuid
  templateKeySnapshot String @map("template_key_snapshot")
  templateVersionNumber Int @map("template_version_number")
  subject String?
  body String
  recipientSnapshot Json @map("recipient_snapshot")
  provenance Json
  templateVersion CorrespondenceTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  deliveryAttempts CorrespondenceDeliveryAttempt[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([templateVersionId, createdAt])
  @@index([createdAt])
  @@map("correspondence_records")
}

model CorrespondenceDeliveryAttempt {
  id String @id @default(uuid()) @db.Uuid
  correspondenceRecordId String @map("correspondence_record_id") @db.Uuid
  attemptNumber Int @map("attempt_number")
  previousAttemptId String? @unique @map("previous_attempt_id") @db.Uuid
  routeSnapshot Json @map("route_snapshot")
  correspondenceRecord CorrespondenceRecord @relation(fields: [correspondenceRecordId], references: [id], onDelete: Restrict)
  previousAttempt CorrespondenceDeliveryAttempt? @relation("CorrespondenceDeliveryRetryChain", fields: [previousAttemptId], references: [id], onDelete: Restrict)
  nextAttempt CorrespondenceDeliveryAttempt? @relation("CorrespondenceDeliveryRetryChain")
  events CorrespondenceDeliveryAttemptEvent[]
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([correspondenceRecordId, attemptNumber])
  @@index([correspondenceRecordId, createdAt])
  @@map("correspondence_delivery_attempts")
}

model CorrespondenceDeliveryAttemptEvent {
  id String @id @default(uuid()) @db.Uuid
  attemptId String @map("attempt_id") @db.Uuid
  status CorrespondenceDeliveryAttemptStatus
  providerReference String? @map("provider_reference")
  failureCode String? @map("failure_code")
  failureMessage String? @map("failure_message")
  metadata Json?
  attempt CorrespondenceDeliveryAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([attemptId, createdAt])
  @@map("correspondence_delivery_attempt_events")
}
